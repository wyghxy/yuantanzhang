DATABASE_URL="file:../data/yuantanzhang.db"
API_PORT=3311
WEB_PORT=3310
API_ORIGIN=http://127.0.0.1:3311
# local: open directly on this computer. password: opt-in protection for a hosted instance.
PERSONAL_AUTH_MODE=local
PERSONAL_USERNAME=owner
# pnpm run setup creates a random password if .env does not exist.
# When creating .env manually, set a unique password (12-72 bytes).
PERSONAL_PASSWORD=
# Use a random value of at least 32 characters for local session signing.
SESSION_SECRET=
UPLOAD_DIR=./data/uploads
